{
  "name": "civicmind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CivicMind — AI-ready civic intelligence and grievance resolution platform (Goa demonstration).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute civicmind-db --local --file=./db/schema.sql"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "hono": "^4.6.14",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
